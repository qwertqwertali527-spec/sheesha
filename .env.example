# Development: copy to .env.local. Never commit actual credentials.
ADMIN_USERNAME=owner
# Development only. Production must use ADMIN_PASSWORD_HASH (npm run hash-password).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# This prototype defaults to noindex and no live bookings.
# Enable only after written local-law review and approved business content.
SITE_PUBLIC_APPROVED=false
LEGAL_REVIEW_COMPLETED=false
# Replace the demo privacy note with a client-owned, lawyer-approved HTTPS policy.
PRIVACY_POLICY_URL=
# Canonical HTTPS domain, e.g. https://yourdomain.ae (only after approval).
SITE_URL=
SERVICE_CLASSIFICATION=unreviewed

# Optional live AI extractor; without this, deterministic guided demo mode is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Production persistence: use client-owned Supabase. Local dev uses .data/layali.sqlite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional internal-only notifications.
RESEND_API_KEY=
TEAM_EMAIL=
NOTIFICATION_FROM_EMAIL=

# WhatsApp is OFF. Only set these after the specific NON-REGULATED use case
# has been cleared under UAE law and Meta policy. Do not enable for tobacco.
WHATSAPP_USE_CASE_APPROVED=false
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v24.0
